{
  "expo": {
    "name": "PianoLearn",
    "slug": "piano-learn",
    "scheme": "pianolearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/android-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/android-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pianolearn.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PianoLearn memerlukan akses mikrofon untuk mendeteksi suara piano asli Anda secara real-time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.pianolearn.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "PianoLearn memerlukan akses mikrofon untuk mendeteksi suara piano asli Anda secara real-time."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37e8f672-83ac-496a-bf4a-1c3d8154576a"
      }
    },
    "owner": "christnayosua0406"
  }
}
